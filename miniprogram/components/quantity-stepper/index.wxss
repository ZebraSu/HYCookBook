@import "../../styles/tokens.wxss";
.stepper { display: flex; align-items: center; justify-content: flex-end; font-family: var(--font-ui); }
.step.step { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; min-width: 44px; padding: 0; margin: 0; line-height: 1; border: 0; background: transparent; }
.step::after { border: 0; }
.disc { display: block; width: 30px; height: 30px; border: 1.5px solid var(--ink); border-radius: 44% 52% 46% 51%; line-height: 27px; text-align: center; font-size: 24px; color: var(--ink); background: var(--paper); box-sizing: border-box; }
.plus-disc { background: var(--pink); border-color: var(--ink); transform: rotate(-5deg); }
.amount { min-width: 20px; text-align: center; font-size: 16px; color: var(--ink); }
.step-disabled { opacity: 0.4; }
.pressed { opacity: 0.65; }
