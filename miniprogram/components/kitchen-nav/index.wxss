.nav {
  position: fixed;
  z-index: 30;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 12rpx 30rpx calc(14rpx + env(safe-area-inset-bottom));
  background: #fff7e8;
  border-top: 2rpx solid #527a4b28;
}
.item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  line-height: 1.5;
  background: transparent;
  border: 0;
  color: #527a4b;
  font-size: 22rpx;
  padding: 4rpx 0;
}
.item::after {
  border: 0;
}
.item image {
  height: 44rpx;
  width: 44rpx;
}
.active::before {
  content: "";
  position: absolute;
  bottom: 0;
  width: 52rpx;
  height: 5rpx;
  background: #a8c978;
  transform: rotate(-3deg);
  border-radius: 30% 60% 40% 50%;
}
.active {
  font-weight: 600;
}
