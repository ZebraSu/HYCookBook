.menu-page { display: flex; flex-direction: column; height: calc(100vh - 56px - env(safe-area-inset-bottom)); overflow: hidden; }
.search-area { flex-shrink: 0; padding: 16px 20px 12px; }
.search-field { display: flex; align-items: center; min-height: 48px; border-radius: 12px; padding: 0 12px; background: var(--field); }
.search-icon { width: 18px; height: 18px; margin-right: 10px; flex-shrink: 0; }
.search-input { flex: 1; width: 0; height: 44px; min-width: 0; font-size: 16px; color: var(--ink); }
.search-placeholder { color: var(--muted); }
.clear-search.clear-search { width: 44px; height: 44px; font-size: 24px; flex-shrink: 0; }
.menu-workspace { display: flex; flex: 1; min-height: 0; overflow: hidden; border-top: 1px solid var(--line); }
.category-rail { width: 76px; height: 100%; flex-shrink: 0; padding-top: 12px; }
.category.category { width: 60px; min-height: 52px; margin: 0 8px 12px; padding: 14px 4px; font-size: 16px; border-radius: 10px; color: var(--muted); }
.category-active.category-active { border-radius: 13px 10px 14px 11px; background: var(--green) var(--button-sketch) center / 100% 100% no-repeat; color: var(--green-ink); font-weight: 600; }
.dish-panel { flex: 1; min-width: 0; height: 100%; width: 0; border-left: 1px solid var(--line); }
.dish-panel-content { padding: 0 16px; }
.section-head { display: flex; align-items: center; justify-content: space-between; padding: 16px 0 4px; }
.section-title { font-size: 18px; font-weight: 600; }
.section-count { font-size: 14px; color: var(--muted); }
.dish-row { display: flex; align-items: center; padding: 16px 0; border-bottom: 1px solid var(--line); }
.dish-photo { width: 104px; height: 104px; border-radius: 12px; margin-right: 12px; flex-shrink: 0; background: var(--paper); }
.dish-info { flex: 1; min-width: 0; }
.dish-name { display: block; font-size: 16px; font-weight: 600; line-height: 1.5; }
.dish-description { display: block; font-size: 14px; color: var(--muted); margin: 4px 0; }
.dish-price { display: block; font-size: 16px; }
.menu-end { padding: 20px 0 24px; text-align: center; font-size: 14px; color: var(--muted); }
.cart-bar { flex-shrink: 0; padding: 8px 20px; border-top: 1px solid var(--line); }
.cart-summary.cart-summary { width: 100%; display: flex; align-items: center; text-align: left; min-height: 60px; }
.cart-summary-copy { flex: 1; min-width: 0; }
.cart-summary-title { display: block; font-size: 16px; font-weight: 600; }
.cart-summary-note { display: block; font-size: 14px; color: var(--muted); margin-top: 4px; }
.cart-link { display: block; padding: 12px 14px; border-radius: 13px 10px 14px 11px; background: var(--green) var(--button-sketch) center / 100% 100% no-repeat; font-size: 14px; font-weight: 600; margin-left: 8px; color: var(--green-ink); white-space: nowrap; }
.empty-state { display: flex; align-items: center; flex-direction: column; padding: 48px 0; text-align: center; }
.empty-title { margin-bottom: 8px; font-size: 16px; }
.reset-button.reset-button { margin-top: 12px; font-size: 14px; color: var(--green-ink); }
@media (max-width: 350px) { .search-area { padding-left: 16px; padding-right: 16px; } .dish-panel-content { padding: 0 12px; } .dish-photo { width: 72px; height: 88px; margin-right: 10px; } .cart-bar { padding: 8px 16px; } .cart-link { padding: 12px 10px; } }
