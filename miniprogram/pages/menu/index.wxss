page {
  background: #f9f8f6;
  color: #3d3935;
}

.menu-page {
  min-height: 100vh;
  padding: 0 0 calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f9f8f6;
}

.top-bar {
  box-sizing: border-box;
  background: rgba(249, 248, 246, 0.92);
  backdrop-filter: blur(18rpx);
  border-bottom: 1rpx solid rgba(234, 199, 174, 0.2);
}

.top-bar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 12rpx;
  box-sizing: border-box;
}

.top-title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.2;
  flex: 1;
  text-align: center;
}

.icon-button {
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 16rpx 40rpx rgba(61, 57, 53, 0.08);
  color: #3d3935;
}

.top-icon {
  width: 48rpx;
  height: 48rpx;
}

.menu-shell {
  display: flex;
  gap: 20rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
}

.category-rail {
  width: 148rpx;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.5);
  border-right: 1rpx solid rgba(234, 199, 174, 0.18);
  border-radius: 0;
  box-sizing: border-box;
  padding: 18rpx 0 36rpx;
}

.category-item {
  position: relative;
  padding: 28rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0.56;
}

.category-item-active {
  opacity: 1;
}

.category-item-active::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 64rpx;
  background: #c5d8c1;
  border-radius: 0 999rpx 999rpx 0;
}

.category-pill {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
  background: transparent;
  transition: background 0.2s ease;
}

.category-item-active .category-pill {
  background: rgba(197, 216, 193, 0.2);
}

.category-icon {
  width: 40rpx;
  height: 40rpx;
}

.category-label {
  font-size: 20rpx;
  text-align: center;
  line-height: 1.4;
  color: #958f8a;
}

.category-item-active .category-label {
  color: #3d3935;
  font-weight: 700;
}

.dish-panel {
  flex: 1;
  background: transparent;
  border: 0;
  border-radius: 0;
  box-sizing: border-box;
  padding: 16rpx 16rpx 0 0;
}

.section-head {
  margin-bottom: 20rpx;
}

.eyebrow {
  font-size: 22rpx;
  text-transform: uppercase;
  letter-spacing: 3rpx;
  color: #958f8a;
  margin-bottom: 8rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
}

.dish-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-bottom: 120rpx;
}

.dish-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid transparent;
}

.dish-main {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.dish-image {
  width: 168rpx;
  height: 168rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.dish-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.dish-name {
  font-size: 32rpx;
  line-height: 1.3;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.dish-description {
  font-size: 20rpx;
  line-height: 1.5;
  color: #958f8a;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.dish-price {
  font-size: 24rpx;
  font-weight: 700;
  margin-top: 4rpx;
}

.add-button {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  border-radius: 32rpx;
  background: #eac7ae;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(234, 199, 174, 0.35);
  position: relative;
}

.plus-vertical,
.plus-horizontal {
  position: absolute;
  background: #ffffff;
  border-radius: 999rpx;
}

.plus-vertical {
  width: 4rpx;
  height: 22rpx;
}

.plus-horizontal {
  width: 22rpx;
  height: 4rpx;
}

.fab {
  position: fixed;
  right: 34rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  width: 108rpx;
  height: 108rpx;
  border-radius: 54rpx;
  background: #eac7ae;
  box-shadow: 0 18rpx 36rpx rgba(61, 57, 53, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
}

.fab-icon {
  width: 48rpx;
  height: 48rpx;
}

.fab-badge {
  position: absolute;
  right: -6rpx;
  top: -4rpx;
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  padding: 0 10rpx;
  box-sizing: border-box;
  background: #c5d8c1;
  color: #3d3935;
  border: 4rpx solid #f9f8f6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
}
