<view class="theme menu-page">
  <view class="search-area"><view class="search-field">
    <image class="search-icon" src="/images/handdrawn/search.svg" />
    <input class="search-input" value="{{query}}" bindinput="search" placeholder="搜索菜名或食材" placeholder-class="search-placeholder" confirm-type="search" maxlength="60" aria-label="搜索菜名或食材" />
    <button wx:if="{{query}}" class="k-button clear-search" bindtap="clearSearch" aria-label="清除搜索">×</button>
  </view></view>
  <view class="menu-workspace">
  <scroll-view class="category-rail" scroll-y show-scrollbar="{{false}}">
    <button wx:for="{{categories}}" wx:key="id" class="k-button category {{activeCategory === item.id && !query ? 'category-active' : ''}}" data-id="{{item.id}}" bindtap="selectCategory" hover-class="pressed" aria-label="{{item.name}}分类" aria-pressed="{{activeCategory === item.id && !query}}">{{item.name}}</button>
  </scroll-view>
  <scroll-view class="dish-panel" scroll-y scroll-top="{{scrollTop}}" show-scrollbar="{{false}}">
    <view class="dish-panel-content">
      <view class="section-head"><text class="section-title">{{sectionTitle}}</text><text class="section-count">{{dishes.length}} 道菜</text></view>
      <view wx:if="{{!dishes.length}}" class="empty-state"><text class="empty-title">暂时没找到这道菜</text><text class="muted">换个菜名或食材试试</text><button class="k-button reset-button" bindtap="resetMenu">查看全部招牌菜 →</button></view>
      <view wx:for="{{dishes}}" wx:key="id" class="dish-row" id="dish-{{item.id}}">
        <image class="dish-photo" src="{{item.image}}" mode="aspectFit" lazy-load aria-label="{{item.name}}" />
        <view class="dish-info">
          <text class="dish-name">{{item.shortName}}</text><text class="dish-description">{{item.description}}</text>
          <text wx:if="{{showPrices && item.price !== null}}" class="dish-price">¥{{item.price}}</text>
          <quantity-stepper dish-id="{{item.id}}" name="{{item.name}}" quantity="{{item.quantity}}" bindchange="updateQuantity" />
        </view>
      </view>
      <view wx:if="{{dishes.length}}" class="menu-end">慢慢挑，凑成喜欢的一餐。</view>
    </view>
  </scroll-view>
  </view>
  <view class="cart-bar"><button class="k-button cart-summary" bindtap="openCart" hover-class="pressed" aria-label="查看已选{{cartCount}}份菜品">
    <view class="cart-summary-copy"><text class="cart-summary-title">{{cartCount ? '已选 ' + cartKinds + ' 道 · ' + cartCount + ' 份' : '还没选菜'}}</text><text class="cart-summary-note">{{cartCount ? '已自动保存在本机' : '点 + 加入今天的菜单'}}</text></view>
    <text class="cart-link">查看已选 ›</text>
  </button></view>
</view>
