<view class="theme home-page tab-page">
  <view class="home-content">
    <view class="home-heading">
      <text>今天也要好好吃饭</text>
      <text class="recommendation-label">今日推荐</text>
    </view>
    <swiper class="poster-carousel" current="{{current}}" autoplay="{{autoplay}}" interval="6000" duration="450" circular bindchange="onPosterChange" aria-label="今日推荐菜品海报，左右滑动切换">
      <swiper-item wx:for="{{posters}}" wx:key="id">
        <image class="hero-poster" src="{{item.poster}}" mode="aspectFit" aria-label="{{item.name}}手绘海报" />
      </swiper-item>
    </swiper>
    <view class="poster-caption">
      <text class="featured-name">{{featured.name}}</text>
      <text class="featured-description">{{featured.description}}</text>
    </view>
    <view class="poster-pagination">
      <button wx:for="{{posters}}" wx:key="id" class="k-button poster-page" data-index="{{index}}" bindtap="selectPoster" aria-label="查看{{item.name}}海报" aria-pressed="{{current === index}}">
        <view class="poster-dot {{current === index ? 'poster-dot-active' : ''}}" />
      </button>
    </view>
    <button class="k-button primary-button home-cta" bindtap="openMenu" hover-class="pressed"><text class="button-label">去选今天的菜</text><image class="button-arrow" src="/images/handdrawn/arrow.svg" /></button>
  </view>
</view>
