page {
  background: #f9f8f6;
  color: #3d3935;
}

.home-page {
  min-height: 100vh;
  padding: calc(24rpx + env(safe-area-inset-top)) 24rpx calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: #f9f8f6;
}

.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.top-spacer,
.icon-button {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.top-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.2;
}

.top-icon {
  width: 48rpx;
  height: 48rpx;
}

.main-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  max-width: 750rpx;
  width: 100%;
  margin: 16rpx auto 0;
}

.hero-shell {
  width: 100%;
  display: flex;
  justify-content: center;
  margin-bottom: 40rpx;
}

.hero-image-wrap {
  position: relative;
  width: 640rpx;
  max-width: 640rpx;
  height: 640rpx;
  max-height: 640rpx;
  border-radius: 320rpx;
  overflow: hidden;
  background: #ffffff;
  box-shadow: 0 16rpx 60rpx rgba(0, 0, 0, 0.04);
}

.hero-image {
  width: 100%;
  height: 100%;
}

.hero-overlay {
  position: absolute;
  inset: 0;
  background: rgba(234, 199, 174, 0.1);
  mix-blend-mode: multiply;
}

.intro {
  text-align: center;
  margin-bottom: 48rpx;
}

.headline {
  font-size: 64rpx;
  line-height: 1.18;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.subhead {
  font-size: 32rpx;
  line-height: 1.6;
  color: #8a847c;
  padding: 0 32rpx;
}

.cta-button {
  width: 100%;
  max-width: 560rpx;
  height: 100rpx;
  border-radius: 48rpx;
  background: #eac7ae;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  box-shadow: 0 16rpx 40rpx rgba(234, 199, 174, 0.4);
}

.cta-arrow {
  position: relative;
  width: 34rpx;
  height: 24rpx;
}

.arrow-shaft {
  position: relative;
  top: 10rpx;
  width: 22rpx;
  height: 4rpx;
  margin-left: 2rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.arrow-head {
  position: absolute;
  right: 2rpx;
  width: 14rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #ffffff;
  transform-origin: right center;
}

.arrow-head-top {
  top: 7rpx;
  transform: rotate(45deg);
}

.arrow-head-bottom {
  top: 15rpx;
  transform: rotate(-45deg);
}

.bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.8);
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  backdrop-filter: blur(18rpx);
}

.bottom-nav-inner {
  display: flex;
  max-width: 750rpx;
  margin: 0 auto;
  padding: 16rpx 24rpx 16rpx;
  box-sizing: border-box;
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 0;
  color: #958f8a;
}

.nav-icon {
  width: 48rpx;
  height: 48rpx;
}

.nav-text {
  font-size: 20rpx;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.nav-text-active {
  color: #eac7ae;
  font-weight: 700;
}
