.home-content { width: 100%; max-width: 520px; margin: 0 auto; padding: 20px 20px 32px; }
.home-heading { display: flex; align-items: center; justify-content: space-between; min-height: 28px; color: var(--muted); font-size: 14px; }
.recommendation-label { color: var(--green-ink); }
.poster-carousel { width: 100%; height: 100vw; max-height: 420px; margin-top: 8px; }
.hero-poster { width: 100%; height: 100%; }
.poster-caption { margin-top: 16px; text-align: center; }
.featured-name { display: block; font-size: 18px; font-weight: 600; line-height: 1.5; }
.featured-description { display: block; margin-top: 4px; color: var(--muted); font-size: 14px; }
.poster-pagination { display: flex; align-items: center; justify-content: center; margin: 2px 0 12px; }
.poster-page.poster-page { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; }
.poster-dot { width: 6px; height: 6px; border-radius: 50%; background: #d9dfd2; }
.poster-dot-active { width: 18px; height: 6px; border-radius: 6px; background: var(--green-ink); }
@media (max-width: 350px) {
  .home-content { padding: 12px 16px 24px; }
  .poster-caption { margin-top: 8px; }
  .featured-name { font-size: 16px; }
  .poster-pagination { margin-bottom: 8px; }
}
@media (max-height: 650px) { .poster-carousel { max-height: 280px; } }
