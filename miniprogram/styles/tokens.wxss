/* Shared colors and type roles for native pages and isolated components. */
.theme {
  --paper: #ffffff;
  --ink: #2d402d;
  --muted: #59644f;
  --green: #a8c978;
  --green-ink: #35552f;
  --pink: #f2a49a;
  --line: #e0e6da;
  --field: #f4f6f1;
  --button-sketch: url("data:image/svg+xml;base64,");
  --font-ui: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  --text-body: 16px;
  --text-note: 14px;
  --radius: 14px;
}
